{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": false
  },
  "include": ["src"]
}
