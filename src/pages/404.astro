---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout 
  title="Page Not Found | HDE"
  description="The page you are looking for does not exist."
>
  <main class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="bg-primary/10 w-24 h-24 rounded-full flex items-center justify-center mb-6 mx-auto">
      <i class="fas fa-exclamation-triangle text-4xl text-primary"></i>
    </div>
    <h1 class="text-5xl font-extrabold text-stone-900 mb-4">404</h1>
    <h2 class="text-2xl font-bold text-stone-800 mb-6">Page Not Found</h2>
    <p class="text-stone-600 mb-8 max-w-md mx-auto">
      We couldn't find the page you're looking for. It might have been moved, deleted, or perhaps the URL is incorrect.
    </p>
    <a href="/" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-primary-hover transition-colors shadow-soft">
      <i class="fas fa-home"></i>
      Return to Homepage
    </a>
  </main>
  
  <Footer />
</Layout>
