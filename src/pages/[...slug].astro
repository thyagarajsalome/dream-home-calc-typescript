---
import Layout from '../layouts/Layout.astro';
import AstroApp from '../AstroApp';

export function getStaticPaths() {
  return [
    { params: { slug: 'dashboard' } },
    { params: { slug: 'plans' } },
    { params: { slug: 'directory' } },
    { params: { slug: 'signin' } },
    { params: { slug: 'signup' } },
    { params: { slug: 'upgrade' } },
    { params: { slug: 'register-pro' } },
    { params: { slug: 'privacy' } },
    { params: { slug: 'terms' } },
    { params: { slug: 'contact' } },
    { params: { slug: 'disclaimer' } },
  ];
}
---

<Layout title="HDE - Home Design English" description="Access the HDE dashboard, plans, directory and more for your home design needs.">
  <AstroApp client:only="react" />
</Layout>
